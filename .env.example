# NCU ee-class MCP Server Configuration
# Copy this file to .env and fill in your credentials.
# NEVER commit your .env file!

EECLASS_BASE_URL=https://ncueeclass.ncu.edu.tw
EECLASS_USERNAME=your_student_id
EECLASS_PASSWORD=your_password

# Directory where downloaded course attachments will be saved
EECLASS_DOWNLOAD_DIR=./downloads

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL) -> outputs to stderr
EECLASS_LOG_LEVEL=INFO

# Run Playwright in headless mode (set to false only when debugging login)
EECLASS_HEADLESS=true
EECLASS_REQUEST_TIMEOUT=30.0
